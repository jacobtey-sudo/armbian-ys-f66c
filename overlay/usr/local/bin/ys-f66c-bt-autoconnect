#!/bin/sh
# Connect trusted Bluetooth audio devices after boot.
# A headset does not reconnect on its own here.
for attempt in 1 2 3 4 5; do
    for mac in $(bluetoothctl devices Paired 2>/dev/null | awk '{print $2}'); do
        info=$(bluetoothctl info "$mac" 2>/dev/null) || continue
        echo "$info" | grep -q "Connected: yes" && continue
        echo "$info" | grep -q "Trusted: yes" || continue
        echo "$info" | grep -qE "Audio Sink|Handsfree" || continue
        bluetoothctl connect "$mac" >/dev/null 2>&1 || true
    done
    sleep 3
done
exit 0
