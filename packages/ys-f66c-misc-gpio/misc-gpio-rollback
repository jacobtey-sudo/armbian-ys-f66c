#!/bin/sh
# Restore the previous misc-gpio module after repeated failed boots.
set -eu

MODDIR="/lib/modules/$(uname -r)/extra"
OLD="${MODDIR}/misc-gpio.ko.old"
NEW="${MODDIR}/misc-gpio.ko"
STATE="/var/lib/misc-gpio-rollback"
COUNT_FILE="${STATE}/count"
LIMIT=3

[ -f "${OLD}" ] || exit 0

mkdir -p "${STATE}"
count=$(cat "${COUNT_FILE}" 2>/dev/null || echo 0)
case "${count}" in
	'' | *[!0-9]*) count=0 ;;
esac
count=$((count + 1))
echo "${count}" >"${COUNT_FILE}"

if [ "${count}" -lt "${LIMIT}" ]; then
	logger -t misc-gpio-rollback "boot attempt ${count}/${LIMIT}"
	exit 0
fi

logger -t misc-gpio-rollback "restoring previous module after ${count} attempts"
cp -f "${OLD}" "${NEW}"
echo 0 >"${COUNT_FILE}"
depmod -a "$(uname -r)" || true
/sbin/reboot -f
